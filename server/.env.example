# =================================================================
# iPET Production & Development Environment Configuration
# =================================================================

# Server Port & CORS
PORT=5000
NODE_ENV=production
# Frontend URL(s) allowed to connect (comma-separated, or * for open access)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Authentication Security (REQUIRED in production)
JWT_SECRET=replace_with_a_long_secure_random_string_here

# Database Configuration
# In production, use MongoDB Atlas (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/ipet?retryWrites=true&w=majority)
# If left blank, falls back to server/data JSON files (ephemeral in serverless)
MONGODB_URI=

# =================================================================
# LLM Brain: Qwen Configuration (Strictly Required by Paper)
# =================================================================
# Option A: Groq (Ultra-fast, Free Tier Available)
# QWEN_ENDPOINT=https://api.groq.com/openai/v1
# QWEN_API_KEY=gsk_your_groq_api_key
# QWEN_BASE_MODEL=qwen-2.5-32b

# Option B: Together AI (OpenAI-Compatible Qwen Models)
# QWEN_ENDPOINT=https://api.together.xyz/v1
# QWEN_API_KEY=your_together_api_key
# QWEN_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Option C: OpenRouter (Multi-model Qwen Gateway)
# QWEN_ENDPOINT=https://openrouter.ai/api/v1
# QWEN_API_KEY=sk-or-your_openrouter_key
# QWEN_BASE_MODEL=qwen/qwen-2.5-7b-instruct

# Option D: Hugging Face Inference API / Endpoints
# QWEN_ENDPOINT=https://api-inference.huggingface.co/models/Qwen/Qwen2.5-7B-Instruct
# QWEN_API_KEY=hf_your_huggingface_token

# Option E: Self-Hosted Ollama (on VPS or local machine)
# OLLAMA_ENDPOINT=http://your-vps-ip:11434
# QWEN_OLLAMA_MODEL=qwen2:7b

# Inference Parameters
QWEN_TEMPERATURE=0.9
QWEN_CONTEXT_LENGTH=2048
QWEN_MAX_NEW_TOKENS=512
QWEN_TIMEOUT_MS=120000

# =================================================================
# Memory & Embeddings
# =================================================================
EMBEDDING_PROVIDER=bge-small-en-v1.5
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
MEMORY_CONFIDENCE_THRESHOLD=0.70
MEMORY_SIMILARITY_THRESHOLD=0.35
MEMORY_RETRIEVAL_K=5

# Optional: Voice Interaction (OpenAI Whisper & TTS fallback)
# OPENAI_API_KEY=
